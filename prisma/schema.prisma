generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Category {
  UPCYCLED_GOODS
  ORGANIC
  ZERO_WASTE
}

enum StockLabel {
  IN_STOCK
  BULK_AVAILABLE
  OUT_OF_STOCK
}

model Product {
  id           String     @id @default(cuid())
  productCode  String     @unique
  name         String
  category     Category
  description  String?
  image        String?
  price        Decimal    @db.Decimal(12, 2)
  priceUnit    String?
  stock        Int
  stockLabel   StockLabel
  whatsappLink String?
  qrCodeId     String?
  qrCode       QrCode?    @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  allocatedEcoEnzymeBatches EcoEnzymeBatch[]
}

model QrCode {
  id          String   @id @default(cuid())
  code        String   @unique
  entityType  String   // "ECO_ENZYME_BATCH" | "PRODUCT"
  primaryKey  String?  // normalized uppercase batchCode or productCode
  primaryName String   // normalized lowercase trimmed containerName or product.name
  targetUrl   String   // canonical site/relative path e.g. "https://teman-pilahfe-main.vercel.app/b/EE-2611-J3TKN5"
  qrDataUrl   String?  @db.Text // cached data URL from qrcode.react
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     EcoEnzymeBatch[]
  products    Product[]

  @@index([entityType, primaryKey])
  @@index([entityType, primaryName])
}

enum NewsStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum NewsVisibility {
  PUBLIC
  PRIVATE
}

model News {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  content     String         @db.Text
  summary     String?
  imageUrl    String?
  category    String
  authors     String[]
  tags        String[]
  status      NewsStatus     @default(DRAFT)
  visibility  NewsVisibility @default(PUBLIC)
  publishDate DateTime?
  endDate     DateTime?
  partnership String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Gallery {
  id          String   @id @default(cuid())
  title       String?
  category    String?
  image       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankSampahVideo {
  id          String   @id @default(cuid())
  title       String
  videoUrl    String
  platform    String   // 'YouTube' | 'TikTok' | 'Instagram'
  thumbnail   String?
  duration    String?
  description String?  @db.Text
  category    String?
  aspect      String?  @default("wide") // "wide" or "tall"
  date        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EcoEnzymeVideo {
  id          String   @id @default(cuid())
  title       String
  videoUrl    String
  platform    String   @default("YouTube") // 'YouTube' | 'TikTok' | 'Instagram' | 'Local'
  thumbnail   String?
  duration    String?
  description String?  @db.Text
  category    String?
  aspect      String?  @default("tall") // "tall" or "wide"
  tags        String[] @default([])
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HeroSlide {
  id          String   @id @default(cuid())
  imageUrl    String
  altText     String?
  caption     String?
  linkUrl     String?
  linkLabel   String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EducationContent {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  overview     String
  description  String
  thumbnail    String?
  tags         String[]
  publishDate  DateTime?
  status       ContentStatus @default(DRAFT)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum EnzymeBatchStatus {
  IN_PROGRESS
  HARVESTED
  FAILED
}

enum EnzymeResidueUsage {
  KOMPOS_PADAT
  PUPUK_ORGANIK
  STARTER_BATCH_BARU
  PENGHARUM_TOILET
}

enum EnzymeFailureReason {
  KONTAMINASI_JAMUR_HITAM
  AROMA_BUSUK_MENYENGAT
  WADAH_BOCOR_RUSAK
  LAINNYA
}

model EcoEnzymeBatch {
  id                     String               @id @default(cuid())
  publicCode             String
  batchCode              String
  containerName          String
  containerCapacityLiter Decimal              @default(50) @db.Decimal(8, 2)

  // Komposisi 1:3:10
  molassesKg             Decimal              @db.Decimal(8, 2)
  organicWasteKg         Decimal              @db.Decimal(8, 2)
  waterLiter             Decimal              @db.Decimal(8, 2)
  organicWasteTypes      String               @default("Kulit Buah Campur")

  // Timeline & Hari
  startDate              DateTime
  harvestEstimate        DateTime
  actualHarvestDate      DateTime?

  // Hasil Panen, Rendemen & Ampas
  harvestLiter           Decimal?             @db.Decimal(8, 2)
  efficiencyRatePercent  Decimal?             @db.Decimal(5, 2)
  residueUsage           EnzymeResidueUsage?
  residueNotes           String?              @db.Text

  // Alokasi ke Katalog Produk
  allocatedProductId     String?
  allocatedProduct       Product?             @relation(fields: [allocatedProductId], references: [id], onDelete: SetNull)
  allocatedUnitsAdded    Int?                 @default(0)

  // Status & Kegagalan
  status                 EnzymeBatchStatus    @default(IN_PROGRESS)
  failureReason          EnzymeFailureReason?
  failureNotes           String?              @db.Text

  // Dokumentasi & Catatan
  photoUrl               String?
  notes                  String?              @db.Text

  // QR Code & Pemantauan Fisik
  qrPrintedAt            DateTime?
  qrCodeId               String?
  qrCode                 QrCode?              @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  // Pemakaian Ulang Galon (Suksesi Batch)
  previousBatchId        String?
  previousBatch          EcoEnzymeBatch?      @relation("BatchSuccession", fields: [previousBatchId], references: [id], onDelete: SetNull)
  nextBatches            EcoEnzymeBatch[]     @relation("BatchSuccession")

  // Soft Delete
  archivedAt             DateTime?

  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  inspectionLogs         EcoEnzymeLog[]

  @@index([publicCode])
  @@index([batchCode])
  @@index([containerName])
  @@index([qrCodeId])
}

model EcoEnzymeLog {
  id          String         @id @default(cuid())
  batchId     String
  batch       EcoEnzymeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  logDate     DateTime       @default(now())
  dayNumber   Int            @default(7)
  phLevel     Decimal?       @db.Decimal(4, 2)
  aromaStatus String?
  fungusColor String?
  actionTaken String?        @db.Text
  imageUrl    String?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
}
